{
  "name": "ftre-desktop",
  "version": "0.1.21",
  "description": "AI Agent Desktop Client - Monorepo",
  "main": "packages/electron/dist/main.js",
  "private": true,
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "storybook": "pnpm --filter @ftre/renderer storybook",
    "build": "pnpm --filter @ftre/shared build && pnpm --filter @ftre/ui build && pnpm --filter @ftre/editor build && pnpm --filter @ftre/electron build && pnpm --filter @ftre/renderer build",
    "clean": "pnpm --filter @ftre/shared clean && pnpm --filter @ftre/editor clean && pnpm --filter @ftre/electron clean && pnpm --filter @ftre/renderer clean && rm -rf node_modules",
    "pack": "npm run build && electron-builder --win --dir",
    "pack:full": "npm run build && electron-builder --win --dir -c electron-builder-full.json",
    "pack:quick": "electron-builder --win --dir -c electron-builder-full.json",
    "dist": "npm run build && electron-builder --win",
    "dist:full": "npm run build && electron-builder --win -c electron-builder-full.json",
    "dist:quick": "electron-builder --win -c electron-builder-full.json",
    "bundle-backend:win": "node scripts/bundle-backend.js --clean --platform win32 --arch x64",
    "bundle-backend:mac:x64": "node scripts/bundle-backend.js --clean --platform darwin --arch x64",
    "bundle-backend:mac:arm64": "node scripts/bundle-backend.js --clean --platform darwin --arch arm64",
    "package:mac:x64": "npm run build && npm run bundle-backend:mac:x64 && electron-builder --mac --x64 -c electron-builder-full.json",
    "package:mac:arm64": "npm run build && npm run bundle-backend:mac:arm64 && electron-builder --mac --arm64 -c electron-builder-full.json",
    "package:win": "npm run build && npm run bundle-backend:win && electron-builder --win --x64 -c electron-builder-full.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "bundle-backend": "node scripts/bundle-backend.js",
    "bundle-backend:clean": "node scripts/bundle-backend.js --clean",
    "test:platform": "pnpm --filter @ftre/shared build && pnpm --filter @ftre/electron build && node --test scripts/tests/backend-runtime.test.cjs scripts/tests/fs-directory.test.cjs",
    "test": "pnpm --filter @ftre/renderer test && npm run test:platform"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.ftre.desktop",
    "productName": "ftre",
    "directories": {
      "output": "release"
    },
    "files": [
      "packages/electron/dist/**/*",
      "packages/electron/assets/**/*",
      "packages/renderer/dist/**/*",
      "packages/shared/dist/**/*",
      "node_modules/node-pty/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "icon": "packages/electron/assets/ftre.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "packages/electron/assets/ftre.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist"
  }
}
