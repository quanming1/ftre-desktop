{
  "appId": "com.ftre.desktop",
  "productName": "ftre",
  "directories": {
    "output": "release"
  },
  "files": [
    "packages/electron/dist/**/*",
    "packages/electron/assets/**/*",
    "packages/renderer/dist/**/*",
    "packages/shared/dist/**/*",
    "node_modules/node-pty/**/*",
    "package.json"
  ],
  "asarUnpack": ["node_modules/node-pty/**/*"],
  "extraResources": [
    {
      "from": "backend/",
      "to": "backend/"
    },
    {
      "from": "scripts/start-gateway.bat",
      "to": "start-gateway.bat"
    },
    {
      "from": "scripts/start-gateway.sh",
      "to": "start-gateway.sh"
    }
  ],
  "win": {
    "icon": "packages/electron/assets/ftre.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "artifactName": "ftre-${version}-mac-${arch}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "npmRebuild": false,
  "electronDist": "node_modules/electron/dist"
}
